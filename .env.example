# Server Configuration
PORT=3000

# Gemini API Key (Provided automatically by AI Studio runtime or set locally)
GEMINI_API_KEY=

# Cloud SQL Database Environment Variables (Optional; app falls back gracefully to local browser persistence when unset)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional Firebase Client Overrides (Defaults to firebase-applet-config.json when unset)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

